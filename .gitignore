# ── Docker data root (images, volumes, n8n sqlite with credentials) ──
docker-data/

# ── Docker toolchain binaries (fetched via fetch_image.py) ──
docker-static/docker/
docker-static/docker-rootless-extras/
docker-static/slirp4netns
docker-static/run/
docker-static/*.log
docker-static/*.pid

# ── Caddy runtime (binary, LE certificates, autosave) ──
caddy/caddy
caddy/caddy.tar.gz
caddy/config/
caddy/data/

# ── sslh binaries (only sslh.cfg is tracked) ──
sslh/sslh
sslh/libconfig.so.*

# ── Secrets & runtime artifacts ──
.env
.env.*
*.sqlite
*.sqlite-journal
watchlist*.json
node_modules/
quant-partner/

# ── OS noise ──
.DS_Store
Thumbs.db

# klines cache for the deep backtest (re-downloadable)
data/

# generated n8n workflow snapshots (written by tools/deploy_*.js)
workflow-*.json
