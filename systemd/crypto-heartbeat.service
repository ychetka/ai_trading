# Dead-man's switch for the collector stack. Runs tools/heartbeat.js once;
# scheduling is done by crypto-heartbeat.timer. Install:
#   cp systemd/crypto-heartbeat.{service,timer} ~/.config/systemd/user/
#   systemctl --user enable --now crypto-heartbeat.timer
[Unit]
Description=Crypto collector heartbeat check
After=rootless-docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/trade-ai-analitic
ExecStart=/usr/bin/env node tools/heartbeat.js
