# Voltrack forward-log report (issue #61). One-shot: aggregates
# signal->outcome results into VOLTRACK_REPORT.md with automatic
# SIGNIFICANT/DEAD/INSUFFICIENT flags per setup.
# Scheduled by voltrack-report.timer (daily).
# Install:
#   cp systemd/voltrack-report.{service,timer} ~/.config/systemd/user/
#   systemctl --user enable --now voltrack-report.timer

[Unit]
Description=voltrack forward-log report
After=voltrack-watch.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/trade-ai-analitic
Environment=PATH=%h/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.18.0/bin/node tools/voltrack_report.js --write
