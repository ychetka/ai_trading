[Unit]
Description=Rootless Docker daemon stack (userns + netns + slirp4netns + port forwarder)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/projects/trade-ai-analitic/docker-static/supervisor.sh
Restart=always
RestartSec=10
Environment=HOME=%h

[Install]
WantedBy=default.target
