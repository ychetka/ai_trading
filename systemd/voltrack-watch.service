# voltrack forward-log collector (issue #47/#53). Runs voltrack.js in --live
# --watch mode: minute-cadence book snapshots from the n8n books-aggregator
# webhook + state rows (events, regime, virtual signals) to a JSONL log.
# Pair with a timer running tools/voltrack_join.js for outcome resolution.
# Install:
#   cp systemd/voltrack-watch.service ~/.config/systemd/user/
#   systemctl --user enable --now voltrack-watch.service

[Unit]
Description=voltrack live forward-log collector
After=rootless-docker.service

[Service]
Type=simple
WorkingDirectory=%h/projects/trade-ai-analitic
Environment=PATH=%h/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.18.0/bin/node tools/voltrack.js \
  --watch --live --interval=60 \
  --universe \
  --out=%h/projects/trade-ai-analitic/data/voltrack_state.jsonl \
  --raw=%h/projects/trade-ai-analitic/data/books_minute.jsonl
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
